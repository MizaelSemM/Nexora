# Copie para .env e preencha. NUNCA commite o .env real.

# Banco de dados — Supabase, região São Paulo (Project Settings > Database > Connection string).
# No MVP, use a "Session pooler" (porta 5432) nos dois campos: funciona para o app E para migrations.
# Otimização futura (P1): DATABASE_URL no transaction pooler (6543) e DIRECT_URL na conexão direta.
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@HOST_DO_PAINEL:5432/postgres"
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SUA_SENHA@HOST_DO_PAINEL:5432/postgres"

# Auth (Better Auth) — gerado na tarefa 003
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# E-mail transacional (Resend) — tarefas 003/009
RESEND_API_KEY=""

# Observabilidade — tarefa 013
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
