# Copie para .env e preencha. NUNCA commite o .env real.

# Banco de dados (Supabase — região São Paulo, projeto de dev)
# App/serverless: use o pooler (porta 6543). Migrations: conexão direta (porta 5432).
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"

# Auth (Better Auth) — gerado na tarefa 003
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# E-mail transacional (Resend) — tarefas 003/009
RESEND_API_KEY=""

# Observabilidade — tarefa 013
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
